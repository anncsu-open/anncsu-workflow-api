# Example environment for the ANNCSU Workflow API. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials or keys.

# --- Application -------------------------------------------------------------
APP_NAME="ANNCSU Workflow Service"
DEBUG=false

# --- Logging (ADR 0014) ------------------------------------------------------
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json       # json (production) | console (development; colored on a TTY)

# --- Inbound security (ADR 0023) --------------------------------------------
# Guards the workflow routes (/anncsu/v1/workflows/*); probes/docs/root stay open.
# API_KEY is REQUIRED (sent by callers in the X-API-KEY header); without it every
# protected call is rejected (401). Never commit the real value.
API_KEY=change-me
# Source-IP allowlist (comma-separated CIDR; a single IP is /32, a subnet is /N).
# Use 0.0.0.0/0 (and ::/0 for IPv6) as the "any IP" wildcard. The caller IP is read
# from X-Real-IP (set by the k8s ingress), else the socket peer. Empty = not
# restricted on this dimension.
ALLOWED_IPS=
# Allowed called hosts (comma-separated). Matched against request.base_url.netloc =
# the Host header VERBATIM, PORT INCLUDED (X-Forwarded-Host is not applied). So local
# testing needs the port (e.g. localhost:8000); behind a k8s ingress the port is
# stripped, so use the bare FQDN. This scopes the API-KEY to the private ingress.
# Empty = not restricted. Tip: a rejection logs `access.host_not_allowed host=<value>`.
ALLOWED_FQDN=

# --- ANNCSU API URLs ---------------------------------------------------------
# Not configured here: each e-service URL is discovered from the voucher audience
# on first use (ADR 0017). Collaudo serves a self-signed certificate, so disable
# TLS verification there (keep it on in production):
VERIFY_SSL=true

# Per-HTTP-operation timeout (seconds) for the ANNCSU e-service calls — explicit
# instead of httpx's implicit 5s default; the inner bound below the transport's
# per-dispatch backstop (ADR 0017). Raise it if a PDND e-service is slow.
HTTP_TIMEOUT=20.0

# --- PDND authentication (ADR 0015) ------------------------------------------
# Read by the anncsu-sdk's ClientAssertionSettings. PDND_AUDIENCE is the client
# assertion audience (no scheme, ends with /client-assertion) and MUST match the
# environment selected by USE_VALIDATION_ENV — the token endpoint is derived from
# it, and a mismatch is rejected by PDND with error 015-0008:
#   production:     auth.interop.pagopa.it/client-assertion
#   validation/UAT: auth.uat.interop.pagopa.it/client-assertion
# A misconfigured PDND_* block fails fast at startup.
PDND_KID=your_kid
PDND_ISSUER=your_client_id
PDND_SUBJECT=your_client_id
PDND_AUDIENCE=auth.interop.pagopa.it/client-assertion
# Signing key — must match the public key registered for PDND_KID. Set exactly ONE
# of PDND_KEY_PATH (a PEM file) or PDND_PRIVATE_KEY (inline PEM, as used in collaudo).
PDND_KEY_PATH=./keys/private_key.pem
# PDND_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Purpose id per API — ALL six must be present (may be left empty for the APIs
# this service does not use: interni and coordinate_bulk).
PDND_PURPOSE_ID_PA=your_pa_purpose_id
PDND_PURPOSE_ID_ACCESSI=your_accessi_purpose_id
PDND_PURPOSE_ID_ODONIMI=your_odonimi_purpose_id
PDND_PURPOSE_ID_COORDINATE=your_coordinate_purpose_id
PDND_PURPOSE_ID_COORDINATE_BULK=
PDND_PURPOSE_ID_INTERNI=

# --- ModI for the write APIs (Agid-JWT-Signature / audit) --------------------
# Audit context (AUDIT_REST_02), used by accessi/odonimi/coordinate:
PDND_MODI_USER_ID=your_user_id
PDND_MODI_USER_LOCATION=your_location
PDND_MODI_LOA=3
# Dedicated ModI signing key — OPTIONAL. GovWay requires it in production (it must
# differ from the voucher key); dev/collaudo can omit it (the voucher key is used,
# with a warning). To enable it, set PDND_MODI_KID and one of the key sources:
# PDND_MODI_KID=your_modi_kid
# PDND_MODI_KEY_PATH=./keys/modi_private_key.pem   # or PDND_MODI_PRIVATE_KEY=<PEM contents>

# --- Environment -------------------------------------------------------------
USE_VALIDATION_ENV=false  # true -> validation (UAT) URLs and UAT token endpoint
