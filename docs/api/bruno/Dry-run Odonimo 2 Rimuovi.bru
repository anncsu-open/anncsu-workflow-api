meta {
  name: Dry-run Odonimo 2 Rimuovi
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/anncsu/v1/workflows/sopprimi-odonimo-completo
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  // Suppress with today's date (DD/MM/YYYY), the format the workflow validates.
  const d = new Date();
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  bru.setVar("dryrun_odonimo_data", `${dd}/${mm}/${d.getFullYear()}`);
}

body:json {
  {
    "codcom": "H501",
    "denom_odonimo": "{{dryrun_odonimo_denom}}",
    "data_soppressione": "{{dryrun_odonimo_data}}"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}

tests {
  test("suppression of the just-created odonimo returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  WRITE OPERATION — step 2 of the self-cancelling "dry-run" pair: suppress the
  odonimo created by step 1 ("Dry-run Odonimo 1 Crea"), so the pair nets to no live
  new odonimo. Run only against collaudo (UAT), and only right after step 1.

  Reads the denomination captured by step 1 from a collection variable
  (dryrun_odonimo_denom); running this request in isolation will send an empty
  denomination and fail. The workflow first suppresses any residual accessi
  (x-executor.foreach), then the odonimo itself — the freshly-created odonimo has no
  accessi, so only the odonimo is suppressed. ANNCSU suppression is dated and logical
  (operation S).
}
