meta {
  name: Ricerca Indirizzo Disambigua Piu Odonimi
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/workflows/ricerca-indirizzo-completo
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "codcom": "H501",
    "denom_odonimo": "AURELIA",
    "numero_civico": "131"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}

tests {
  test("an ambiguous denomination returns all candidates, not the first match", function() {
    expect(res.status).to.equal(200);
    expect(res.body.odonimi.length).to.be.above(1);
    expect(res.body.accessi).to.be.an("array").that.is.empty;
  });

  test("each candidate carries its prognaz to re-query", function() {
    res.body.odonimi.forEach(function (o) { expect(o).to.have.property("prognaz"); });
  });
}

docs {
  Disambiguation (ADR 0018): "AURELIA" matches several odonimi (CIRCONVALLAZIONE,
  RAMPA, VIA AURELIA, ...). The search never silently queries the first match: it
  returns every candidate with an empty `accessi` list, so the caller picks a
  prognaz and re-queries with `ricerca-accessi-per-odonimo`.

  Validated against PDND collaudo (UAT): "AURELIA" civic 131 -> odonimi=11,
  accessi=0.
}
